<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Settings saved before ForeCal was sandboxed (today color, hidden
	     calendars, last location). macOS moves them into the sandbox
	     container the first time the sandboxed app launches. -->
	<key>Move</key>
	<array>
		<string>${Library}/Preferences/com.cconway.ForeCal.plist</string>
	</array>
</dict>
</plist>
